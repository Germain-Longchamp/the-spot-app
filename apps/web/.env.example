# Copiez ce fichier vers .env.local et renseignez les valeurs.
# Ne jamais committer .env.local dans le dépôt.

# Supabase — projet de développement
# Trouvez ces valeurs dans : https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_anon_key

# Clé secrète, côté serveur uniquement : panneau opérateur et scripts.
# Ne jamais la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=votre_service_role_key
