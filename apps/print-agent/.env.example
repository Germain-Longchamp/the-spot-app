# Copiez ce fichier vers .env et renseignez les valeurs.
# Ne jamais committer .env dans le dépôt.

# Supabase — utiliser le projet de développement en dev, le projet salon en production
# Trouvez ces valeurs dans : https://app.supabase.com → Settings → API
SUPABASE_URL=https://VOTRE_PROJET.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre_service_role_key

# Identifiant de l'événement servi par cet agent
EVENT_ID=00000000-0000-0000-0000-000000000000

# Facultatif (valeurs par défaut entre parenthèses)
# AGENT_ID=salon-1                       (nom de l'ordinateur)
# PHOTOS_BUCKET=photos                   (photos)
# POLL_INTERVAL_MS=2000                  (2000)
# HEARTBEAT_INTERVAL_MS=15000            (15000)

# Imprimante simulée, en attendant le vrai modèle (SCRUM-26)
# SIMULATED_PRINTER_DELAY_MS=3000        (3000 ; augmenter pour simuler la lenteur)
# SIMULATED_PRINTER_OUTCOME=failure      (success)
